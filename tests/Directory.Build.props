<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CS8618 stays off for the tests: ~730 properties on EF entity/model POCOs are populated by EF or the test itself, and
         `= null!` or `required` on each would only be noise. CS8602 and the other nullable warnings are on. -->
    <NoWarn>EF1001,CS8618</NoWarn>
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JunitXml.TestLogger" Version="7.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Testcontainers" Version="4.16.0" />
  </ItemGroup>

  <!-- SSH.NET 2025.1.0 arrives transitively via Testcontainers (test-only, never shipped, and the SSH client is not used by
       the tests). Suppress just these advisories so any other audit finding still surfaces; remove once Testcontainers
       moves to a fixed SSH.NET. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-mggc-4xg6-vcxf" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q939-rpr3-3284" />
  </ItemGroup>
</Project>

<Project>
  <PropertyGroup>
    <EF8Version>8.0.34</EF8Version>
    <EF9Version>9.0.23</EF9Version>
    <EF10Version>10.0.15</EF10Version>
    <EF11Version>11.0.0</EF11Version>
    <!-- DRIVER_VERSION env variable could be set by the CI to test EF Provider compatibility with different (newer) versions of the MongoDB.Driver -->
    <CSharpDriverVersion Condition="'$(DRIVER_VERSION)' == ''">3.13.0</CSharpDriverVersion>
    <CSharpDriverVersion Condition="'$(DRIVER_VERSION)' != ''">$(DRIVER_VERSION)</CSharpDriverVersion>
  </PropertyGroup>
</Project>

<Project>
  <PropertyGroup>
    <!-- EF version is selected by build Configuration (Debug/Release EF8|EF9|EF10), not by
         TargetFramework, so each configuration restores a different set of package versions.
         NuGet's restore outputs (project.assets.json, *.nuget.g.props/targets, etc.) are written
         to $(MSBuildProjectExtensionsPath), which defaults to the *unqualified* obj\ directory -
         shared across configurations - so building multiple configurations concurrently races on
         those files. Give restore its own subdirectory per configuration; leave
         BaseIntermediateOutputPath (compiled output) untouched, since it is already segregated by
         configuration and default item excludes ("obj\**") key off it. -->
    <MSBuildProjectExtensionsPath>obj\$(Configuration)\</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Every warning fails the build, locally and in CI, in all configurations. Exceptions are in WarningsNotAsErrors
         (they still show as warnings):
         - CS1591: missing XML comment on a publicly visible type or member (not enforced).
         - NU1901-NU1904: NuGet audit advisories. A new advisory against a dependency would otherwise break the build with
           no code change; Dependabot tracks these. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
